@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Filum requires math library
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/FilumTargets.cmake" OPTIONAL)

set(FILUM_INCLUDE_DIRS "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@/filum")
set(FILUM_LIBRARIES fl_common fl_shard fl_herald)
set(FILUM_VERSION "@PROJECT_VERSION@")

check_required_components(Filum)
